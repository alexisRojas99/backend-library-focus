{
  "name": "backend-node-typescript",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node ./dist/app.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --rs --watch ./api/docs/index.yaml ./app.ts",
    "openapi": "yamlinc -o ./api/docs/index.yaml ./api/docs/openapi/base.yaml && yaml2json ./api/docs/temp.yaml > ./api/docs/temp.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migration:generate": "sequelize-cli migration:generate --name",
    "migration:delete:all": "sequelize-cli db:migrate:undo:all",
    "migration:run": "sequelize-cli db:migrate",
    "seed:generate": "sequelize-cli seed:generate --name",
    "seed:delete:all": "sequelize-cli db:seed:undo:all",
    "seed:run": "sequelize-cli db:seed:all"
  },
  "keywords": [],
  "author": "Alexis Rojas",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.11.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^2.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cron": "^2.0.0",
    "dayjs": "^1.11.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^8.5.1",
    "pg": "^8.8.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.21.6",
    "swagger-ui-express": "^4.4.0",
    "yamlinc": "^0.1.10",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
    "@types/cron": "^2.0.0",
    "@types/express": "^4.17.13",
    "@types/js-yaml": "^4.0.5",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/node": "^18.0.3",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/yamljs": "^0.2.31",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "eslint": "^8.19.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "sequelize-cli": "^6.4.1",
    "ts-node": "^10.8.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.7.4"
  }
}
